{
  "name": "vibe-dictionary-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only local MCP for searching Vibe Dictionary techniques and retrieving implementation prompts",
  "type": "module",
  "bin": {
    "vibe-dictionary-mcp": "dist/index.js"
  },
  "files": ["dist/index.js", "README.md"],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/index.js",
    "test": "npm run build && node --import tsx --test tests/*.test.ts",
    "start": "node dist/index.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~5.6.2"
  }
}
