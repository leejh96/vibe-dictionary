{
  "name": "vibe-dictionary",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev --workspace vibe-dictionary-web --",
    "test": "npm run test:web && npm run test:mcp",
    "test:web": "npm test --workspace vibe-dictionary-web",
    "test:mcp": "npm test --workspace @keke1933/vibe-dictionary-mcp",
    "build:mcp": "npm run build --workspace @keke1933/vibe-dictionary-mcp",
    "check:package": "npm run build:mcp && node --import tsx scripts/check-mcp-package.mjs",
    "start:mcp": "node apps/mcp/dist/index.js",
    "build": "npm run build:web && npm run build:mcp",
    "build:web": "npm run build --workspace vibe-dictionary-web",
    "preview": "npm run preview --workspace vibe-dictionary-web --"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "~5.6.2"
  }
}
